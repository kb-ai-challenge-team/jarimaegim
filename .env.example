# Browser-visible configuration (leave blank until you provide keys)
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_PRIVACY_RIGHTS_EMAIL=

# Internal routing
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
APP_ORIGIN=http://127.0.0.1:4173
APP_ENV=development

# Supabase server-side data storage credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANON_TOKEN_PEPPER=

# Kakao server-side Local REST API
KAKAO_REST_API_KEY=

# AI Gateway / OpenAI
OPENAI_API_KEY=
AI_CHAT_MODEL=
AI_EXPLANATION_ENABLED=true

# Official public-data credentials
SEOUL_OPEN_DATA_KEY=
DATA_GO_KR_SERVICE_KEY=
BIZINFO_API_KEY=
KSTARTUP_API_KEY=
FINLIFE_API_KEY=

# Verified endpoint templates from each provider dashboard/docs.
# Keep blank until the provider contract is verified; the service will never invent an endpoint.
SEOUL_COMMERCIAL_API_URL=
BIZINFO_API_URL=
KSTARTUP_API_URL=
FINLIFE_API_URL=
FINLIFE_API_BASE_URL=

# Privacy rights contact
PRIVACY_RIGHTS_EMAIL=

# Safety and retention
ANONYMOUS_SESSION_HOURS=24
DOCUMENT_STORAGE_DIR=.data/documents
POLICY_PARAMS_PATH=config/policy-params.json
AI_DAILY_REQUEST_LIMIT=20
FINANCIAL_APPLICATION_ENABLED=false
CONSULTATION_TRANSFER_ENABLED=false
MYDATA_ENABLED=false
